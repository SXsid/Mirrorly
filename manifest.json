{
  "manifest_version": 3,
  "name": "Mirrorly",
  "version": "1.0.0",
  "description": "Try on clothes from Myntra using AI",

  "permissions": ["storage", "tabs", "scripting"],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Mirrorly"
  },

  "content_scripts": [
    {
      "matches": ["https://*.myntra.com/*"],
      "js": ["script/myntra.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "./options.html",
  "host_permissions": ["<all_urls>"]
}
